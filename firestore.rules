rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    function esDespachador() {
      return autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'despachador';
    }

    function esDomiciliario() {
      return autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'domiciliario';
    }

    function esAfiliado() {
      return autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'afiliado';
    }

    // =========================================================
    // USUARIOS
    // =========================================================
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create: if autenticado() && request.auth.uid == uid;
      allow update: if autenticado() && (request.auth.uid == uid || esAdmin() || esDespachador());
      allow delete: if esAdmin();
    }

    // =========================================================
    // ÍNDICE DE ACCESOS POR CÉDULA
    // =========================================================
    match /accesosCedula/{cedula} {
      allow get: if true;
      allow list: if false;
      allow create: if autenticado();
      allow update, delete: if autenticado() && (
        resource.data.uid == request.auth.uid ||
        esAdmin()
      );
    }

    // =========================================================
    // PEDIDOS & CHECKPOINTS
    // =========================================================
    match /pedidos/{pedidoId} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update: if autenticado();
      allow delete: if esAdmin();

      match /checkpoints/{checkpointId} {
        allow read: if autenticado();
        allow create, update: if autenticado();
        allow delete: if false;
      }
    }

    // =========================================================
    // RECETAS MÉDICAS
    // =========================================================
    match /recetas/{recetaId} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update: if autenticado();
      allow delete: if esAdmin();
    }

    // =========================================================
    // INVENTARIO / CATÁLOGO
    // =========================================================
    match /inventario/{itemId} {
      allow read: if autenticado();
      allow write: if autenticado();
    }

    // =========================================================
    // UBICACIONES DE DOMICILIARIOS
    // =========================================================
    match /ubicacionesDomiciliarios/{uid} {
      allow read: if autenticado();
      allow create, update: if autenticado() && request.auth.uid == uid;
      allow delete: if false;
    }

    // =========================================================
    // REPORTES Y AUDITORÍA
    // =========================================================
    match /reportes/{reporteId} {
      allow read, write: if autenticado();
    }

    // =========================================================
    // PQRS
    // =========================================================
    match /pqrs/{pqrsId} {
      allow create: if autenticado();
      allow read: if autenticado();
      allow update: if autenticado();
      allow delete: if esAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}