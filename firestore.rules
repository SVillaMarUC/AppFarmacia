rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================
    // USUARIOS
    // ================================
    match /usuarios/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    // ================================
    // PEDIDOS
    // ================================
    match /pedidos/{pedidoId} {

      // Usuario autenticado puede consultar pedidos
      allow read: if request.auth != null;

      // Crear pedidos
      allow create: if request.auth != null;

      // Actualizar pedidos
      allow update: if request.auth != null;

      // Eliminar pedidos
      allow delete: if request.auth != null;

      // ================================
      // CHECKPOINTS DEL PEDIDO
      // ================================
      match /checkpoints/{checkpointId} {

        // Consultar checkpoints
        allow read: if request.auth != null;

        // Registrar o actualizar checkpoint
        allow create, update: if request.auth != null
          && request.resource.data.domiciliarioId == request.auth.uid;

        // No permitimos eliminar checkpoints
        allow delete: if false;
      }
    }

    // ================================
    // UBICACIONES DE DOMICILIARIOS
    // ================================
    match /ubicacionesDomiciliarios/{uid} {

      // Consultar ubicación
      allow read: if request.auth != null;

      // Un domiciliario solamente puede
      // actualizar su propia ubicación
      allow create, update: if request.auth != null
        && request.auth.uid == uid;

      // No eliminar historial/ubicación
      allow delete: if false;
    }

    // ================================
    // INVENTARIO
    // ================================
    match /inventario/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}