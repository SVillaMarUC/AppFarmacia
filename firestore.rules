rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function usuarioData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return autenticado() && usuarioData().rol == 'administrador';
    }

    function esDespachador() {
      return autenticado() && usuarioData().rol == 'despachador';
    }

    function esDomiciliario() {
      return autenticado() && usuarioData().rol == 'domiciliario';
    }

    function esAfiliado() {
      return autenticado() && usuarioData().rol == 'afiliado';
    }

    // =========================================================
    // USUARIOS
    // =========================================================
    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin() || esDespachador() || esDomiciliario());
      allow create: if autenticado() && request.auth.uid == uid;
      allow update: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow delete: if esAdmin();
    }

    // =========================================================
    // ÍNDICE DE ACCESOS POR CÉDULA
    // =========================================================
    match /accesosCedula/{cedula} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if autenticado();
      allow update, delete: if autenticado() && (
        resource.data.uid == request.auth.uid || esAdmin()
      );
    }

    // =========================================================
    // INVENTARIO / CATÁLOGO
    // =========================================================
    match /inventario/{itemId} {
      allow read: if autenticado();
      allow write: if esDespachador() || esAdmin();
    }

    // =========================================================
    // RECETAS MÉDICAS
    // =========================================================
    match /recetas/{recetaId} {
      allow read: if autenticado() && (
        resource.data.usuarioId == request.auth.uid || esDespachador() || esAdmin()
      );
      allow create: if autenticado() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if autenticado() && (
        (esAfiliado() && resource.data.usuarioId == request.auth.uid && resource.data.estado == 'pendiente') ||
        esDespachador() ||
        esAdmin()
      );
      allow delete: if esAdmin();
    }

    // =========================================================
    // PEDIDOS & CHECKPOINTS
    // =========================================================
    match /pedidos/{pedidoId} {
      allow read: if autenticado() && (
        resource.data.usuarioId == request.auth.uid ||
        resource.data.domiciliarioId == request.auth.uid ||
        esDespachador() ||
        esAdmin()
      );
      allow create: if autenticado() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if autenticado() && (
        (esDomiciliario() && resource.data.domiciliarioId == request.auth.uid) ||
        esDespachador() ||
        esAdmin()
      );
      allow delete: if esAdmin();

      match /checkpoints/{checkpointId} {
        allow read: if autenticado();
        allow create, update: if autenticado() && (
          request.resource.data.domiciliarioId == request.auth.uid || esAdmin() || esDespachador()
        );
        allow delete: if false;
      }
    }

    // =========================================================
    // UBICACIONES DE DOMICILIARIOS
    // =========================================================
    match /ubicacionesDomiciliarios/{uid} {
      allow read: if autenticado();
      allow create, update: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow delete: if false;
    }

    // =========================================================
    // REPORTES Y AUDITORÍA
    // =========================================================
    match /reportes/{reporteId} {
      allow read, write: if esAdmin();
    }

    // =========================================================
    // PQRS
    // =========================================================
    match /pqrs/{pqrsId} {
      allow create: if autenticado() && request.resource.data.usuarioId == request.auth.uid;
      allow read: if autenticado() && (
        resource.data.usuarioId == request.auth.uid || esAdmin()
      );
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}