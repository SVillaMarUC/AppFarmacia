# ==============================================================================
# APP FARMACIA / FARMA YA - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo como `.env` en la raíz del proyecto:
#   cp .env.example .env   (o copia manual en Windows)
#
# NOTA IMPORTANTE:
# En Expo / React Native, las variables consumidas en la app deben iniciar con
# el prefijo `EXPO_PUBLIC_`. Nunca almacenes credenciales maestras de servidor
# (service accounts, claves privadas de administrador) en este archivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CONFIGURATION (Requerido: Auth y Firestore)
# ------------------------------------------------------------------------------
# Obtenidas de la consola de Firebase: Configuración del Proyecto > General > Tus apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE (Requerido: Almacenamiento seguro de recetas médicas)
# ------------------------------------------------------------------------------
# Obtenidas de Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_public_key
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=recetas-medicas

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD APIS (Opcional en desarrollo local)
# ------------------------------------------------------------------------------
# Clave de Google Maps Platform (para visualización y geocodificación en Android/iOS)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...your_maps_key_here

# Clave de Google Cloud Vision (OCR de recetas médicas)
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=AIzaSy...your_google_vision_key_here

# ------------------------------------------------------------------------------
# 4. FLAGS DE DESARROLLO Y SIMULACIÓN
# ------------------------------------------------------------------------------
# Si es 'true', desactiva la subida real a Supabase Storage y utiliza almacenamiento local en memoria
EXPO_PUBLIC_DISABLE_STORAGE_UPLOADS=false

# Si es 'true', desactiva la llamada a Google Vision y utiliza el analizador heurístico local para OCR
EXPO_PUBLIC_DISABLE_GOOGLE_VISION=true